# Generated by tamp — do not edit.
#
# The one router this machine has. tamp rewrites this file whenever it starts
# the router, and no environment appears in it: tamp attaches the router to
# each environment's network itself, so that creating or removing one
# environment never rewrites the router's own definition — or restarts it.
name: {{ .Project }}

services:
  {{ .Service }}:
    image: {{ .Image }}
    # Bound to loopback: *.localhost resolves there, and a development machine
    # has no business serving somebody's bench to the rest of the network.
    ports:
      - "127.0.0.1:{{ .Port }}:{{ .ListenPort }}"
    volumes:
      # Read through a bind mount, so tamp can rewrite the routes and reload
      # the container in place rather than recreating it.
      - ./{{ .Caddyfile }}:{{ .ContainerCaddyfile }}:ro

# No restart policy, as with every container tamp runs: after a host reboot
# nothing comes back until 'tamp start'.
