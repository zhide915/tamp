# Generated by tamp — do not edit.
#
# tamp rewrites this file from tamp.toml on every 'tamp start'; anything you
# change here disappears the next time the environment starts. Edit tamp.toml.
#
# tamp also passes this project name to compose with --project-name, which is
# what actually decides it; the line below is here so that running plain
# `docker compose` in this directory acts on the same project tamp does.
name: {{ .Project }}

services:
  # The bench container.
  frappe:
    image: {{ .BenchImage }}
    # Idle until there is a bench to run, honcho once there is. The choice is
    # made here, at boot, rather than by tamp: starting a stopped environment
    # then brings its processes back with nothing tamp has to remember.
    #
    # DEV_SERVER is what tells Frappe to serve with the reloading Werkzeug
    # server rather than assume something in front of it.
    #
    # FRAPPE_BIND_ADDR is not optional: on Frappe's develop branch the dev
    # server binds 127.0.0.1, which the router's container cannot reach. The
    # release branches bind 0.0.0.0 already and ignore it.
    command:
      - bash
      - -c
      - |
        if [ -f {{ .ProcfilePath }} ]; then
          cd {{ .BenchDir }}
          . {{ .EnvScript }}
          exec env DEV_SERVER=1 FRAPPE_BIND_ADDR={{ .BindAddr }} honcho start
        fi
        exec sleep infinity
    working_dir: {{ .BenchDir }}
    depends_on:
      mariadb:
        condition: service_healthy
      redis-cache:
        condition: service_healthy
      redis-queue:
        condition: service_healthy
    volumes:
      # The bench, split into the volumes tamp manages separately: source in
      # the workspace, the virtualenv, and every site's files.
      - code:{{ .WorkspaceDir }}
{{- if .AppsBind }}
      # The source layer, bound straight from the host. This is the Linux
      # answer: the container reads the host's filesystem at native speed with
      # inotify working, so nothing has to be mirrored. Elsewhere neither of
      # those holds, and tamp runs a sync session instead of writing this line.
      - {{ .AppsBind }}:{{ .AppsDir }}
{{- end }}
      - deps:{{ .EnvDir }}
      - sites:{{ .SitesDir }}
      # Shared with every other environment on this machine — see below.
      - toolchain:{{ .ToolchainDir }}
      - pip-cache:{{ .PipCacheDir }}
      - yarn-cache:{{ .YarnCacheDir }}
      - templates:{{ .TemplateDir }}
      - seeds:{{ .SeedDir }}

  # One MariaDB per environment, at the version this Frappe release wants.
  # The character-set flags are not optional: without them site creation fails
  # on collation errors.
  mariadb:
    image: {{ .MariaDBImage }}
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/{{ .DBSecretName }}
    secrets:
      - {{ .DBSecretName }}
    # The one host port an environment publishes: database GUI clients
    # need a real TCP port. Bound to loopback — this is a development database.
    ports:
      - "127.0.0.1:{{ .DBPort }}:3306"
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      # Not the image's healthcheck.sh: 10.8 never provisions its healthcheck
      # user. Bootstrap is socket-only, so answering TCP means the real server.
      test: ["CMD-SHELL", "mariadb-admin ping --protocol=tcp -uroot -p\"$(cat /run/secrets/{{ .DBSecretName }})\" --silent"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 30s

  # Two Redis from v15 on: socketio shares the queue instance. Neither is
  # published — nothing outside the environment network talks to them.
  redis-cache:
    image: {{ .RedisImage }}
    healthcheck: &redis-healthcheck
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  redis-queue:
    image: {{ .RedisImage }}
    healthcheck: *redis-healthcheck

  # Every mail the environment sends lands here. The UI is reached through the
  # router at mail.{{ .Name }}.localhost, so no port is published.
  mailpit:
    image: {{ .MailpitImage }}

# No service has a restart policy, deliberately: after a host reboot nothing
# comes back until 'tamp start'.

secrets:
  {{ .DBSecretName }}:
    file: {{ .DBSecretFile }}

volumes:
  # The data layer: every site's database. Survives 'tamp stop' and
  # 'tamp rm'; 'tamp rm --volumes' and 'tamp clean --data' destroy it.
  db:
    name: {{ .DBVolume }}
  # The bench, including apps/. With sync off it holds the only copy of the
  # source, so 'tamp rm --volumes' spares it; in the other modes the source
  # lives on the host and this copy is disposable.
  code:
    name: {{ .CodeVolume }}
  # The deps layer: the virtualenv, rebuilt rather than backed up.
  deps:
    name: {{ .DepsVolume }}
  # Site files: what a snapshot protects, alongside the database.
  sites:
    name: {{ .SitesVolume }}

  # Shared by every environment on this machine. They are declared external so
  # that they are nobody's to destroy: 'tamp rm --volumes' on one environment
  # takes its own volumes and leaves the machine's Pythons, Nodes and package
  # caches for the others. tamp creates them before it brings anything up.
  toolchain:
    name: {{ .ToolchainVolume }}
    external: true
  pip-cache:
    name: {{ .PipCacheVolume }}
    external: true
  yarn-cache:
    name: {{ .YarnCacheVolume }}
    external: true
  # The bench template store: one tarball per Frappe version, so the first
  # 'bench init' on this machine is the only slow one.
  templates:
    name: {{ .TemplateVolume }}
    external: true
  # The seed store: one pristine site backup per Frappe version and app set,
  # so an app set is installed onto a site once on this machine.
  seeds:
    name: {{ .SeedVolume }}
    external: true

networks:
  default:
    name: {{ .Network }}
